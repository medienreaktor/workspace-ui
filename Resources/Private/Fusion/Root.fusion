include: **/*

prototype(Medienreaktor.Site:Document) {

  @context.changes = ${Workspaces.getDocumentDifferences(documentNode)}
//      @process.changes = ${Json.stringify(changes)}
  renderer.@process.debug = Neos.Fusion:Debug.Console {
    value = ${changes}
  }
    prototype(Medienreaktor.Site:Content) {

    @context.id = ${node.aggregateId.value}
      @process.changeOverlay = ${'<div style="position: relative;">' + value + '<div style="position: absolute;top: 0; left:0;width:100%;height:100%;opacity: 0.5; background: red;"></div></div>'}
    @process.changeOverlay.@if.isChanged = ${changes[id]}
    @process.changeOverlay.@if.difference = ${request.arguments.difference == 'true'}

  }
}
